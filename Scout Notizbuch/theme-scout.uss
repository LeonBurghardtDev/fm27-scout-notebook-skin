/* Scout Notizbuch — token overrides on top of theme.uss.
 * Palette: dark sheet, cream ink, gold lines. IBM Plex type.
 * Change a colour here; keep its -alpha-* companions in sync (gen script). */
:root {
  --skin-surface-canvas: rgb(27, 25, 21);
  --skin-surface-page: rgb(33, 30, 26);
  --skin-surface-navigation: rgb(27, 25, 21);
  --skin-surface-panel: rgb(42, 39, 35);
  --skin-surface-raised: rgb(50, 46, 41);
  --skin-surface-strong: rgb(62, 57, 49);
  --skin-text-primary: rgb(238, 231, 216);
  --skin-text-secondary: rgb(189, 180, 162);
  --skin-text-disabled: rgb(140, 132, 117);
  --skin-ink: #221E17;
  --skin-border-default: rgb(91, 81, 61);
  --skin-border-subtle: rgb(73, 66, 51);
  --skin-control-background: rgb(50, 46, 41);
  --skin-control-hover: rgb(60, 55, 48);
  --skin-control-pressed: rgb(72, 65, 55);
  --skin-control-border: rgb(110, 98, 74);
  --skin-selection-muted: rgb(58, 52, 42);
  --skin-focus-ring: rgb(217, 196, 143);
  --skin-brand-primary: rgb(183, 160, 110);
  --skin-brand-primary-hover: rgb(201, 180, 132);
  --skin-brand-primary-pressed: rgb(150, 129, 84);
  --skin-brand-on-primary: rgb(34, 30, 23);
  --skin-brand-accent-soft: rgb(217, 196, 143);
  --skin-card-border-width: 1px;
  --skin-card-border-colour: var(--skin-border-subtle);
  --skin-dialog-border: var(--skin-brand-primary);
  --skin-nav-active-indicator: var(--skin-brand-primary);
  --skin-table-row-alternate-background: rgba(183, 160, 110, 0.06);
  --skin-list-selection-background: rgb(62, 55, 42);
  --skin-data-sky: rgb(143, 180, 190);
  --skin-data-amber: rgb(232, 185, 106);
  --skin-data-mint: rgb(162, 190, 134);
  --skin-data-coral: rgb(214, 130, 106);
  --skin-data-blue: rgb(140, 160, 196);
  --skin-data-sand: rgb(217, 196, 143);
  --skin-data-steel: rgb(160, 170, 165);
  --skin-data-rose: rgb(200, 150, 140);
  --skin-data-comparison-cyan: rgb(143, 196, 184);
  --skin-data-comparison-orange: rgb(232, 165, 80);
  --skin-finance-category-fund-raising-colour: #A89F8C;
  --skin-finance-category-other-colour: #EEE7D8;
  --skin-feedback-warning: rgb(232, 185, 106);
  --skin-feedback-warning-surface: rgb(66, 52, 32);
  --skin-feedback-danger: rgb(222, 128, 104);
  --skin-feedback-danger-surface: rgb(70, 38, 30);
  --skin-feedback-success: rgb(162, 200, 128);
  --skin-feedback-success-surface: rgb(40, 52, 32);
  --skin-feedback-info: rgb(150, 180, 200);
  --skin-feedback-info-surface: rgb(34, 46, 54);
  --skin-medical-risk-high-background: rgb(64, 40, 30);
  --skin-medical-risk-high-foreground: rgb(232, 150, 106);
  --skin-on-media: rgb(238, 231, 216);
  --skin-font-family-primary: url("fonts/IBMPlexSans-Regular.ttf");
  --skin-font-family-display: url("fonts/IBMPlexSans-SemiBold.ttf");
  --skin-font-family-navigation: url("fonts/IBMPlexSans-SemiBold.ttf");
  --skin-font-secondary-navigation: url("fonts/IBMPlexSans-Regular.ttf");
  --skin-font-size-13: 12px;
  --skin-font-size-14: 13px;
  --skin-font-size-15: 14px;
  --skin-font-size-16: 15px;
  --skin-font-size-18: 16px;
  --skin-font-size-19: 17px;
  --skin-font-size-20: 18px;
  --skin-font-size-22: 20px;
  --skin-font-size-24: 22px;
  --skin-font-size-26: 24px;
  --skin-font-size-30: 27px;
  --skin-font-secondary-navigation-size: var(--skin-font-size-13);
  --skin-menu-tile-heading-size: var(--heading-md-size);
  --skin-font-family-condensed: url("fonts/IBMPlexSansCondensed-Regular.ttf");
  --skin-radius-micro: 0px;
  --skin-radius-hairline: 0px;
  --skin-radius-compact: 0px;
  --skin-radius-small: 0px;
  --skin-radius-medium: 0px;
  --skin-radius-control: 0px;
  --skin-radius-tight: 0px;
  --skin-radius-card: 0px;
  --skin-radius-shell: 0px;
  --skin-radius-extra-large: 0px;
  --skin-data-sky-alpha-16: rgba(143, 180, 190, 0.16);
  --skin-data-amber-alpha-16: rgba(232, 185, 106, 0.16);
  --skin-data-mint-alpha-16: rgba(162, 190, 134, 0.16);
  --skin-data-coral-alpha-16: rgba(214, 130, 106, 0.16);
