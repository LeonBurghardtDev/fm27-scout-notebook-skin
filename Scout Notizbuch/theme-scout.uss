  --skin-on-media-alpha-04: rgba(238, 231, 216, 0.04);
  --skin-surface-canvas-alpha-70: rgba(27, 25, 21, 0.7);
  --skin-surface-canvas-alpha-60: rgba(27, 25, 21, 0.6);
  --skin-surface-canvas-alpha-55: rgba(27, 25, 21, 0.55);
  --skin-on-media-alpha-18: rgba(238, 231, 216, 0.18);
  --skin-on-media-alpha-06: rgba(238, 231, 216, 0.06);
  --skin-on-media-alpha-25: rgba(238, 231, 216, 0.25);
