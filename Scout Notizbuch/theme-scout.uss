  --skin-surface-canvas-alpha-14: rgba(27, 25, 21, 0.14);
  --skin-surface-canvas-alpha-12: rgba(27, 25, 21, 0.12);
  --skin-surface-canvas-alpha-08: rgba(27, 25, 21, 0.08);
  --skin-surface-canvas-alpha-04: rgba(27, 25, 21, 0.04);
  --skin-on-media-alpha-90: rgba(238, 231, 216, 0.9);
  --skin-on-media-alpha-85: rgba(238, 231, 216, 0.85);
  --skin-on-media-alpha-75: rgba(238, 231, 216, 0.75);
  --skin-on-media-alpha-65: rgba(238, 231, 216, 0.65);
