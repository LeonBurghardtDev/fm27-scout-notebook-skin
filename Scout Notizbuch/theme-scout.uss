  --skin-data-comparison-orange-alpha-16: rgba(232, 165, 80, 0.16);
  --skin-brand-primary-alpha-08: rgba(183, 160, 110, 0.08);
  --skin-brand-primary-alpha-16: rgba(183, 160, 110, 0.16);
  --skin-brand-primary-alpha-70: rgba(183, 160, 110, 0.7);
  --skin-brand-primary-alpha-00: rgba(183, 160, 110, 0);
  --skin-brand-accent-alpha-40: rgba(183, 160, 110, 0.4);
  --skin-surface-page-alpha-60: rgba(33, 30, 26, 0.6);
  --skin-surface-page-alpha-70: rgba(33, 30, 26, 0.7);
  --skin-surface-page-alpha-100: rgba(33, 30, 26, 1);
  --skin-brand-accent-alpha-20: rgba(183, 160, 110, 0.2);
  --skin-surface-page-alpha-05: rgba(33, 30, 26, 0.05);
  --skin-surface-page-alpha-72: rgba(33, 30, 26, 0.72);
  --skin-surface-page-alpha-76: rgba(33, 30, 26, 0.76);
  --skin-surface-page-alpha-80: rgba(33, 30, 26, 0.8);
  --skin-surface-page-alpha-85: rgba(33, 30, 26, 0.85);
  --skin-brand-primary-hover-alpha-00: rgba(201, 180, 132, 0);
  --skin-feedback-danger-surface-alpha-00: rgba(70, 38, 30, 0);
  --skin-feedback-danger-alpha-00: rgba(222, 128, 104, 0);
  --skin-surface-page-alpha-65: rgba(33, 30, 26, 0.65);
  --skin-surface-page-alpha-35: rgba(33, 30, 26, 0.35);
  --skin-brand-accent-alpha-35: rgba(183, 160, 110, 0.35);
